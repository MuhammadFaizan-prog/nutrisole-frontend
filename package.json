{
  "name": "nutrisole-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "check:runtime": "node scripts/check-mobile-runtime.mjs",
    "update:runtime-lock": "node scripts/update-mobile-runtime-lock.mjs",
    "test:runtime": "playwright test",
    "test:sites": "node --test tests/sites-worker.test.mjs",
    "test:expansion": "node --test tests/expansion.test.mjs",
    "figma:build": "node scripts/build-expansion-figma.mjs",
    "figma:check": "tsc -p artifacts/expansion/figma-plugin-check.json",
    "predev": "npm run check:runtime",
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/domain.test.ts",
    "test:glucose": "node --experimental-strip-types --import ./tests/glucose/resolve-ts.mjs --test tests/glucose/*.test.ts",
    "test:glucose:db": "bash supabase/tests/run-local.sh",
    "test:glucose:ocr": "node --experimental-strip-types --import ./tests/glucose/resolve-ts.mjs tests/glucose/ocr-accuracy.mjs",
    "native:start": "npm --prefix native start",
    "native:typecheck": "npm --prefix native run typecheck",
    "native:lint": "npm --prefix native run lint",
    "native:export": "npm --prefix native run export:check",
    "prebuild": "npm run check:runtime",
    "build": "tsc && vite build && node scripts/prepare-sites-build.mjs",
    "ocr:eval:run": "node --experimental-strip-types --no-warnings --import ./tests/glucose/resolve-ts.mjs tests/glucose/ocr-eval/ocr-run.mjs",
    "ocr:eval:score": "node --experimental-strip-types --no-warnings --import ./tests/glucose/resolve-ts.mjs tests/glucose/ocr-eval/score.mjs"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@fontsource/libre-caslon-display": "^5.3.0",
    "@fontsource/roboto": "5.2.10",
    "@radix-ui/react-dialog": "1.1.19",
    "@radix-ui/react-dropdown-menu": "2.1.20",
    "@radix-ui/react-icons": "1.3.2",
    "@use-gesture/react": "10.3.1",
    "fflate": "0.8.3",
    "jpeg-js": "0.4.4",
    "lucide-react": "^1.48.0",
    "motion": "12.42.2",
    "onnxruntime-web": "1.23.2",
    "pdfjs-dist": "6.4.299",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-native-web": "^0.21.3"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "@types/node": "^26.6.3",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@types/react-native-web": "^0.19.3",
    "@vitejs/plugin-react": "6.0.3",
    "tesseract.js": "7.0.0",
    "typescript": "7.0.2",
    "vite": "8.1.3"
  },
  "engines": {
    "node": "24.x"
  }
}
