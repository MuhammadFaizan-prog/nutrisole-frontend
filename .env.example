# Copy to .env.local. PUBLIC values only: the Supabase project URL and its publishable/anon key.
# Never put a service-role or secret key in any VITE_ variable, the repo or CI.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Explicit demo flag for glucose (in-memory, labelled "not saved"). Leave empty for real use.
VITE_GLUCOSE_DEMO=
